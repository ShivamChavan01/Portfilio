# Server only. Create a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=
# Reviewed strict-output model. Other models fail closed.
# Included in Groq's Free Plan limits as checked on 2026-11-04.
GROQ_MODEL=openai/gpt-oss-20b

# Public PostHog project token from Project settings (not a personal API key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Copy the ingestion host for your project's region.
# US: https://us.i.posthog.com  EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
